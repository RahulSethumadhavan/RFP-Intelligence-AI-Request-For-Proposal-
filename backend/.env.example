# LLM Provider: 'groq', 'openai', 'gemini', 'anthropic', or 'mock' (default offline demo mode)
LLM_PROVIDER=groq

# Groq Credentials & Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI Credentials & Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1


# Google Gemini Credentials & Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Credentials & Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Inference Settings
TEMPERATURE=0.0
MAX_TOKENS=4096

# Application Settings
DEBUG=false
LOG_LEVEL=INFO
